# ============================================
# AEGEN/MAGI Configuration Template
# ============================================

# --- LLM Provider Configuration ---
# Options: "groq", "google", "openrouter"
LLM_PROVIDER=groq

# Groq Configuration (Primary - Recommended)
GROQ_API_KEY=
GROQ_MODEL_NAME=moonshotai/kimi-k2-instruct-0905

# Google Gemini Configuration (Round-Robin Key Rotation)
# Para maximizar rate limits gratuitos (1500 RPM por key), usar
# múltiples API keys de Google AI Studio. El RoundRobinKeyProvider
# las rota automáticamente con cooldown de 60s ante rate limit.
# Fallback: GOOGLE_API_KEY (Vertex AI) se usa si no hay keys numeradas.
GEMINI_API_KEY_1=   # Google AI Studio - Cuenta 1
GEMINI_API_KEY_2=   # Google AI Studio - Cuenta 2
GEMINI_API_KEY_3=   # Google AI Studio - Cuenta 3
GOOGLE_API_KEY=      # Vertex AI (fallback, opcional si hay keys numeradas)

# OpenRouter Configuration (Fallback 2)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openai/gpt-oss-120b:free

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- External Services ---
TELEGRAM_BOT_TOKEN=

# --- Database ---
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_URL=redis://redis:6379/1
REDIS_SESSION_TTL=3600

# --- Observability ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=MAGI
LANGCHAIN_API_KEY=

# --- Optional APIs ---
YOUTUBE_API_KEY=
TAVILY_API_KEY=
CHROMA_API_KEY=

# === LLM Models por Tarea ===
# Chat Principal y Razonamiento
CHAT_MODEL=moonshotai/kimi-k2-instruct-0905
CHAT_FALLBACK_MODEL=gpt-oss-120
REASONING_MODEL=moonshotai/kimi-k2-instruct-0905

# Audio (Groq Whisper)
AUDIO_MODEL=whisper-large-v3-turbo

# RAG (Gemini - usa RoundRobinKeyProvider para rotación de keys)
RAG_MODEL=gemini-2.5-flash-lite  # Configurable: cambiar por modelo disponible

# Routing y Default
ROUTING_MODEL=moonshotai/kimi-k2-instruct-0905
DEFAULT_LLM_MODEL=moonshotai/kimi-k2-instruct-0905
